[]byte("# Proxy config for the lab, mounted at /etc/proxy/proxy.toml, with the\n# certificates from lab/gen-certs.sh mounted at /etc/proxy/certs.\n# Check it with: docker compose -f lab/docker-compose.yml exec proxy \\\n#   /usr/local/bin/proxy -config /etc/proxy/proxy.toml -check-config\n#\n# HTTPS on 8443: SNI picks the certificate and the pool. Plain HTTP on 8080\n# redirects to it.\n\n# Hosts with no route, including the container healthcheck (no SNI).\ndefault_pool = \"all\"\n\n[[listener]]\naddress = \"0.0.0.0:8443\"\nmode    = \"https\"\n\n[[listener]]\naddress       = \"0.0.0.0:8080\"\nmode          = \"redirect\"\nredirect_port = 8443\n\n[[route]]\nhost = \"a.test\"\npool = \"pool_a\"\ncert = \"certs/a.test.crt\"\nkey  = \"certs/a.test.key\"\n\n[[route]]\nhost = \"b.test\"\npool = \"pool_b\"\ncert = \"certs/b.test.crt\"\nkey  = \"certs/b.test.key\"\n\n# Rate limited for the Phase 6 k6 check (bench/phase6/k6.sh): each client\n# address gets 200 requests per second with a burst of 20. It has no\n# certificate of its own, so it is served the default one; k6 cannot be\n# given the lab CA and skips verification anyway.\n[[route]]\nhost = \"limited.test\"\npool = \"pool_a\"\nrate_limit = { rate = 200, burst = 20 }\n\n# Served to clients without SNI and to names with no route.\n[tls]\ndefault_cert = \"certs/default.test.crt\"\ndefault_key  = \"certs/default.test.key\"\n\n[pool.all]\nalgorithm = \"round_robin\"\nbackends  = [\n  { address = \"10.0.0.11:8000\" },\n  { address = \"10.0.0.12:8000\" },\n  { address = \"10.0.0.13:8000\" },\n]\n\n[pool.pool_a]\nalgorithm = \"least_conn\"\nbackends  = [\n  { address = \"10.0.0.11:8000\" },\n  { address = \"10.0.0.12:8000\" },\n  { address = \"10.0.0.13:8000\" },\n]\n\n[pool.pool_b]\nalgorithm = \"consistent_hash\"\nhash_key  = \"header:X-User-Id\"\nbackends  = [\n  { address = \"10.0.0.11:8000\" },\n  { address = \"10.0.0.12:8000\" },\n  { address = \"10.0.0.13:8000\" },\n]\n\n[timeouts]\nhandshake_ms         = 5000\nheader_read_ms       = 5000\nupstream_connect_ms  = 1000\nupstream_response_ms = 10000\nidle_ms              = 60000\nclient_io_ms         = 60000\n# How long SIGTERM waits for open requests; inside docker stop's 10 s.\nshutdown_ms          = 8000\n\n# Health checks: active checks every second, and passive ejection after\n# three failures in a row in live traffic, for five seconds.\n[health]\npath             = \"/healthz\"\ninterval_ms      = 1000\ntimeout_ms       = 500\nrise             = 2\nfall             = 3\npassive_failures = 3\neject_ms         = 5000\n\n# /metrics, /status and pprof, on loopback inside the proxy container.\n# Promet_eus shares the container's network namespace to scrape it.\n[admin]\naddress = \"127.0.0.1:9901\"\n\n# Rate limiting is off by default ([rate_limit] sets no rate) and on for the\n# routes that ask for it. Buckets for clients idle a whole refill time are\n# swept every 10 s.\n[rate_limit]\nmax_entries = 100000\nsweep_ms    = 10000\n\n# One client address may hold at most this many connections; more are\n# closed at accept, before the TLS handshake. High enough for the Phase 9\n# runs at concurrency 1,000 from the single loadgen.\n[limits]\nmax_conns_perhip = 2048\n# The test backends' /echo streams, but a real backend may read a body\n# whole: cap what reaches it.\nmax_body_bytes   = 104857600\n")
